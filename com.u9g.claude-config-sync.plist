<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.u9g.claude-config-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO_DIR__/sync.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>1</integer>
	<key>WatchPaths</key>
	<array>
		<string>__HOME__/.claude/CLAUDE.md</string>
	</array>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/claude-config-sync.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/claude-config-sync.log</string>
</dict>
</plist>
